---
import Base from "../../layouts/Base.astro";
import ProductVisual from "../../components/ProductVisual.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products, related, familyOf, productApps, APPLICATIONS, formatAh, spec, type Product } from "../../lib/catalogue";
import { fileSize } from "../../lib/files";
import { SITE } from "../../site";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const fam = familyOf(p);
const apps = APPLICATIONS.filter((a) => productApps(p).includes(a.key));
const rel = related(p, 4);
const url = `${SITE.url}/product/${p.slug}/`;
const quick = [
  ["Voltage", `${p.voltage}V`],
  ["Capacity", formatAh(p.capacityAh)],
  ["Weight", p.weight],
  ["Terminal", spec(p, "Terminal")],
];

const ld = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: p.name,
    sku: p.sku,
    mpn: p.sku,
    description: p.intro || p.summary,
    url,
    image: p.image ? `${SITE.url}${p.image}` : undefined,
    brand: { "@type": "Brand", name: "Leadcrystal" },
    category: `${p.voltage}V lead crystal battery`,
    weight: p.weight ? { "@type": "QuantitativeValue", value: parseFloat(p.weight), unitCode: "KGM" } : undefined,
    additionalProperty: p.specs.map((s) => ({ "@type": "PropertyValue", name: s.label, value: s.value })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Catalogue", item: `${SITE.url}/catalogue/` },
      { "@type": "ListItem", position: 3, name: `${p.voltage}V`, item: `${SITE.url}/product-category/${p.voltage}v/` },
      { "@type": "ListItem", position: 4, name: p.name },
    ],
  },
];
---

<Base title={p.seoTitle || p.name} description={p.seoDescription || p.summary} image={p.image ?? undefined} type="product" jsonLd={ld}>
  <section class="prod">
    <div class="wrap">
      <nav aria-label="Breadcrumb">
        <ol class="crumbs mono">
          <li><a href="/">Home</a></li>
          <li><a href="/catalogue/">Catalogue</a></li>
          <li><a href={`/product-category/${p.voltage}v/`}>{p.voltage}V</a></li>
          <li><span aria-current="page">{p.sku}</span></li>
        </ol>
      </nav>

      <div class="layout">
        <div class="visual">
          <ProductVisual product={p} size="hero" eager />
          <p class="mono dim cap">Lead crystal (SiO₂) · {fam.label}</p>
        </div>

        <div class="info">
          <p class="sku mono">{p.sku}</p>
          <h1 class="display h-md">{p.name}</h1>
          <p class="lede">{p.intro || p.summary}</p>

          <dl class="quick">
            {
              quick.map(([k, v]) => (
                <div>
                  <dt class="label">{k}</dt>
                  <dd>{v || "—"}</dd>
                </div>
              ))
            }
          </dl>

          <div class="actions">
            <a class="btn" href={`/contact/?model=${encodeURIComponent(p.sku)}#enquiry`}>Request a quote <span class="arrow" aria-hidden="true">→</span></a>
            {
              p.specSheet && (
                <a class="btn btn--ghost" href={p.specSheet} target="_blank" rel="noopener">
                  Spec sheet <span class="mono dim">PDF · {fileSize(p.specSheet)}</span>
                </a>
              )
            }
          </div>
          <p class="price-note dim">Pricing on request. Nationwide delivery across Saudi Arabia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight section--rule">
    <div class="wrap detail">
      <div>
        <h2 class="label">Product attributes</h2>
        <ul class="attrs">
          {
            p.attributes.map((a) => (
              <li>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                {a}
              </li>
            ))
          }
        </ul>
        {
          apps.length > 0 && (
            <>
              <h2 class="label apps-h">Applications</h2>
              <div class="apps">
                {apps.map((a) => (
                  <a class="chip" href={`/catalogue/?app=${a.key}`}>
                    {a.label}
                  </a>
                ))}
              </div>
            </>
          )
        }
      </div>
      <div>
        <h2 class="label">Product specifications</h2>
        <table class="spec-table">
          <tbody>
            <tr><th scope="row">Model</th><td class="mono">{p.sku}</td></tr>
            {
              p.specs.map((s) => (
                <tr>
                  <th scope="row">{s.label}</th>
                  <td>{s.value}</td>
                </tr>
              ))
            }
            <tr><th scope="row">Type</th><td>{fam.label} ({fam.code})</td></tr>
          </tbody>
        </table>
        {
          p.specSheet && (
            <a class="link-arrow sheet-link" href={p.specSheet} target="_blank" rel="noopener">
              Download full specification sheet <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  {
    rel.length > 0 && (
      <section class="section section--tight section--rule">
        <div class="wrap">
          <div class="rel-head">
            <h2 class="display h-md">Other {p.voltage}V models</h2>
            <a class="link-arrow" href={`/product-category/${p.voltage}v/`}>
              All {p.voltage}V batteries <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="rel">
            {rel.map((r) => <ProductCard product={r} />)}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .prod {
    padding-block: clamp(28px, 4vw, 48px) clamp(48px, 7vw, 96px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 clamp(24px, 4vw, 44px);
    padding: 0;
    font-size: 0.74rem;
    color: var(--dim);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 8px;
    color: var(--line-2);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
  .layout {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .cap {
    margin: 12px 0 0;
    font-size: 0.74rem;
    text-align: center;
  }
  .info {
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .sku {
    margin: 0;
    padding: 6px 10px;
    border: 1px solid rgba(140, 117, 255, 0.45);
    border-radius: 3px;
    font-size: 0.82rem;
    color: var(--crystal);
    letter-spacing: 0.06em;
  }
  .info h1 {
    line-height: 1.02;
  }
  .info .lede {
    margin: 0;
  }
  .quick {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4px 0 0;
    border-block: 1px solid var(--line);
  }
  .quick div {
    padding: 16px 12px 16px 0;
  }
  .quick div + div {
    padding-left: 14px;
    border-left: 1px solid var(--line);
  }
  .quick dt {
    font-size: 0.64rem;
    color: var(--dim);
  }
  .quick dd {
    margin: 6px 0 0;
    font-size: 1.15rem;
    font-weight: 700;
    font-stretch: 112%;
  }
  @media (max-width: 520px) {
    .quick {
      grid-template-columns: 1fr 1fr;
    }
    .quick div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .quick div:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .actions .mono {
    font-size: 0.72rem;
    font-weight: 400;
  }
  .price-note {
    margin: 0;
    font-size: 0.86rem;
  }
  .detail {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 900px) {
    .detail {
      grid-template-columns: 1fr 1fr;
      gap: 80px;
    }
  }
  .detail h2.label {
    margin: 0 0 18px;
    color: var(--crystal);
  }
  .attrs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .attrs li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.04rem;
  }
  .attrs svg {
    width: 18px;
    flex-shrink: 0;
    color: var(--accent-hi);
  }
  .apps-h {
    margin-top: 36px !important;
  }
  .apps {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sheet-link {
    margin-top: 24px;
  }
  .rel-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    margin-bottom: 32px;
  }
  .rel {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  @media (max-width: 520px) {
    .rel {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
  }
</style>
