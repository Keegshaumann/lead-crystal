---
import Base from "../layouts/Base.astro";
import WhitepaperDialog from "../components/WhitepaperDialog.astro";
import ArticleCard from "../components/ArticleCard.astro";
import Industries from "../components/Industries.astro";
import { SITE } from "../site";
import { products, articles, FAMILIES, capacityRange, formatAh } from "../lib/catalogue";
import { fileSize } from "../lib/files";

const [minAh, maxAh] = capacityRange(products);
const familyCount = (k: string) => products.filter((p) => p.family === k).length;
const latest = articles.slice(0, 3);

// Hero figures. Every number is one the old site already published.
const STATS = [
  { to: 6000, dec: 0, pre: "", suf: "+", unit: "cycles", note: "at 20% depth of discharge" },
  { to: 65, dec: 0, pre: "+", suf: "°C", unit: "rated", note: "operating, from −40°C" },
  { to: 2.5, dec: 1, pre: "", suf: "h", unit: "full charge", note: "0 to 100%" },
  { to: 99, dec: 0, pre: "", suf: "%", unit: "recyclable", note: "non-hazardous" },
];

const MANIFESTO =
  "Most batteries keep their energy in liquid acid. Ours keep it in crystal. Nothing to spill. Nothing to top up. Nothing to catch fire. Just steady power, in heat that stops other batteries.";

const STEPS = [
  {
    kicker: "The problem",
    title: "Liquid acid is the weak link.",
    body: "Conventional flooded lead-acid batteries hold their electrolyte as liquid sulphuric acid. It can spill, vent gas and dry out in high heat, which is why they need ventilation, topping up and early replacement.",
    facts: ["Spills and corrosion", "Venting and top-ups", "Short life in the heat"],
    label: "Liquid",
  },
  {
    kicker: "The breakthrough",
    title: "We turn it into crystal.",
    body: "Lead crystal replaces the liquid with a patented SiO₂ (silica) composite. Inside the sealed cell it sets into a stable, non-corrosive crystalline structure.",
    facts: ["Patented SiO₂ electrolyte", "Non-corrosive", "No free liquid"],
    label: "Crystal",
  },
  {
    kicker: "The result",
    title: "A sealed cell that just works.",
    body: "Maintenance-free, with no fire or explosion risk. It recovers from a full 0V discharge, recharges up to three times faster than lead acid and runs from −40°C to +65°C.",
    facts: ["6,000+ cycles at 20% DoD", "0 to 100% in 2.5 hours", "Up to 18 years float life (2V)"],
    label: "Cell",
  },
  {
    kicker: "End of life",
    title: "And 99% of it comes back.",
    body: "A spent lead crystal battery is non-hazardous and 99% recyclable, so almost all of it can be recovered and reused instead of going to landfill.",
    facts: ["99% recyclable", "Non-hazardous", "Built for a circular economy"],
    label: "Loop",
  },
];

// Operating ranges as published in "What is lead crystal battery technology?"
const CHEMS = [
  { key: "lc", name: "Lead crystal", min: -40, max: 65, note: "−40°C to +65°C" },
  { key: "agm", name: "AGM", min: -20, max: 50, note: "−20°C to +50°C" },
  { key: "li", name: "Lithium (LiFePO₄)", min: 0, max: 45, note: "0°C to +45°C charging" },
];
const T_MIN = -40;
const T_MAX = 70;
const pct = (t: number) => ((t - T_MIN) / (T_MAX - T_MIN)) * 100;

// Voltage classes for the range conveyor, each shown with a real product photo.
const VOLTS = [
  { v: 2, img: "/images/products/CNFJ-1000.webp", uses: "Utility-scale storage, telecom shelters and large UPS banks." },
  { v: 6, img: "/images/products/3-CNFJ-200.webp", uses: "Solar strings, golf and utility vehicles, floor machines." },
  { v: 8, img: "/images/products/4-EVFJ-135.webp", uses: "Electric vehicles and traction duty." },
  { v: 12, img: "/images/products/6-CNFJ-100.webp", uses: "Solar, telecom, UPS, marine, security and mobility." },
].map((x) => {
  const list = products.filter((p) => p.voltage === x.v);
  const [lo, hi] = capacityRange(list);
  return { ...x, count: list.length, lo, hi };
});

const title = "Lead Crystal Batteries for Industrial Energy Storage";
const description =
  "Lead crystal batteries for solar, telecom, UPS and EV use. 6,000+ cycles, −40°C to +65°C, 99% recyclable. 2V, 6V, 8V and 12V models from Riyadh, Saudi Arabia.";
---

<Base
  title={title}
  description={description}
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Leadcrystal",
      url: SITE.url,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
  ]}
>
  <link slot="head" rel="preload" as="image" href="/media/hero-1920.webp" />

  <div class="progress" aria-hidden="true"><span data-progress></span></div>

  <!-- ============ HERO ============ -->
  <section class="hero" data-hero data-accent="violet">
    <div class="hero-media" aria-hidden="true" data-hero-media>
      <video class="bgv" autoplay muted loop playsinline preload="auto" poster="/media/hero-1920.webp" data-bgvideo>
        <source src="/media/hero-1280.mp4" type="video/mp4" media="(max-width: 900px)" />
        <source src="/media/hero-1920.mp4" type="video/mp4" />
      </video>
      <div class="hero-sweep"></div>
      <div class="hero-shade"></div>
      <canvas class="hero-dust" data-hero-dust></canvas>
    </div>

    <div class="wrap hero-inner" data-hero-copy>
      <p class="label eyebrow hero-in" style="--i:0">Lead crystal battery technology · Riyadh</p>
      <h1 class="display hero-title">
        <span class="line"><span style="--i:1">Energy</span></span>
        <span class="line"><span style="--i:2">Evolved.</span></span>
      </h1>
      <p class="lede hero-in" style="--i:3">
        Batteries with a crystal heart, for solar, telecom, UPS and mobility. Built for 65°C heat, thousands of cycles and zero maintenance.
      </p>
      <div class="cta-row hero-in" style="--i:4">
        <a class="btn btn--glow" href="/catalogue/">Explore the range <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#technology">See how it works</a>
      </div>
    </div>

    <div class="wrap hero-foot hero-in" style="--i:5">
      <dl class="stats">
        {
          STATS.map((s) => (
            <div class="stat">
              <dt class="label">{s.unit}</dt>
              <dd>
                <span class="fig" data-pre={s.pre} data-suf={s.suf}><span data-count={s.to} data-dec={s.dec} set:text={s.dec ? s.to.toFixed(s.dec) : s.to.toLocaleString("en-US")} /></span>
                <span class="note">{s.note}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <a class="scroll-cue" href="#story" aria-label="Scroll to the story"><span></span></a>
  </section>

  <!-- ============ MANIFESTO ============ -->
  <section class="manifesto" id="story" data-accent="crystal">
    <div class="wrap">
      <p class="label eyebrow">Why crystal</p>
      <p class="manifesto-text" data-words>
        {MANIFESTO.split(" ").map((w) => <span class="w">{w} </span>)}
      </p>
    </div>
  </section>

  <!-- ============ HOW IT WORKS (pinned particle scene) ============ -->
  <section class="science" id="technology" data-science data-accent="crystal" aria-labelledby="science-title">
    <h2 class="sr-only" id="science-title">How lead crystal technology works</h2>
    <div class="science-stage" aria-hidden="true">
      <div class="science-fallback"></div>
      <canvas class="science-canvas" data-crystal-canvas></canvas>
      <div class="science-hud wrap">
        <p class="hud-num mono"><span data-hud-num>01</span> / 04</p>
        <ol class="hud-steps mono">
          {STEPS.map((s, i) => <li data-hud-step={i} class={i === 0 ? "is-on" : ""}>{s.label}</li>)}
        </ol>
        <div class="hud-bar"><span data-hud-bar></span></div>
      </div>
    </div>

    <div class="science-steps" data-steps>
      {
        STEPS.map((s, i) => (
          <article class="step" data-step={i}>
            <div class="wrap">
              <div class="step-card">
                <p class="label eyebrow">
                  {String(i + 1).padStart(2, "0")} · {s.kicker}
                </p>
                <h3 class="display h-lg">{s.title}</h3>
                <p class="step-body">{s.body}</p>
                <ul class="facts">
                  {s.facts.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ============ CRYSTAL BAND (video) ============ -->
  <section class="band" data-band data-accent="crystal">
    <div class="band-media" data-band-media aria-hidden="true">
      <video class="bgv" muted loop playsinline preload="none" poster="/media/crystal-1920.webp" data-bgvideo>
        <source src="/media/crystal-1280.mp4" type="video/mp4" media="(max-width: 900px)" />
        <source src="/media/crystal-1920.mp4" type="video/mp4" />
      </video>
      <div class="band-shade"></div>
    </div>
    <div class="wrap band-inner" data-band-copy>
      <p class="label eyebrow">Patented SiO₂ electrolyte</p>
      <h2 class="display h-xl">Crystal,<br />not liquid.</h2>
      <p class="lede">
        The silica composite holds the electrolyte in a stable crystalline structure. Nothing to spill, nothing to boil off, nothing to top
        up.
      </p>
      <a class="link-arrow" href="/what-is-lead-crystal-battery-technology/">How lead crystal technology works <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <!-- ============ PERFORMANCE (bento) ============ -->
  <section class="section perf" data-accent="violet">
    <div class="wrap">
      <div class="section-head" data-rv>
        <p class="label eyebrow">Performance</p>
        <h2 class="display h-lg">Numbers that hold up.</h2>
      </div>

      <div class="bento">
        <article class="tile tile--cycles" data-rv>
          <div class="cycle-ring" aria-hidden="true">
            <svg viewBox="0 0 200 200" data-ticks>
              {
                Array.from({ length: 60 }, (_, i) => {
                  const a = (i / 60) * Math.PI * 2 - Math.PI / 2;
                  return (
                    <line
                      x1={100 + Math.cos(a) * 78}
                      y1={100 + Math.sin(a) * 78}
                      x2={100 + Math.cos(a) * 92}
                      y2={100 + Math.sin(a) * 92}
                    />
                  );
                })
              }
            </svg>
          </div>
          <p class="label">Cycle life</p>
          <p class="big-fig">
            <span data-count="6000" data-dec="0">6,000</span>+
          </p>
          <p class="muted">Charge and discharge cycles at 20% depth of discharge. That's years of daily solar cycling from one battery.</p>
        </article>

        <article class="tile tile--charge" data-rv>
          <p class="label">Fast charge</p>
          <div class="charge">
            <svg viewBox="0 0 120 120" aria-hidden="true">
              <circle cx="60" cy="60" r="50" class="track" />
              <circle cx="60" cy="60" r="50" class="fill" pathLength="100" data-charge />
            </svg>
            <p class="mid-fig"><span data-count="2.5" data-dec="1">2.5</span><small>h</small></p>
          </div>
          <p class="muted">0 to 100%, up to three times faster than conventional lead acid.</p>
        </article>

        <article class="tile tile--recycle" data-rv>
          <p class="label">Recyclable</p>
          <p class="mid-fig"><span data-count="99" data-dec="0">99</span><small>%</small></p>
          <p class="muted">Non-hazardous at end of life. Almost every gram can be recovered.</p>
        </article>

        <article class="tile tile--temp" data-rv>
          <div class="temp-head">
            <div>
              <p class="label">Operating range</p>
              <p class="mid-fig">−40°C <span class="to">to</span> +65°C</p>
            </div>
            <p class="muted">No active cooling. Wider than AGM and lithium.</p>
          </div>
          <div class="ranges" aria-hidden="true">
            {
              CHEMS.map((c) => (
                <div class={`rg rg--${c.key}`}>
                  <span class="rg-name">{c.name}</span>
                  <span class="rg-track">
                    <span class="rg-bar" style={`left:${pct(c.min)}%;width:${pct(c.max) - pct(c.min)}%`} />
                  </span>
                </div>
              ))
            }
            <div class="rg-axis mono">
              {[-40, 0, 25, 50, 65].map((t) => (
                <span style={`left:${pct(t)}%`}>{t > 0 ? `+${t}` : t === 0 ? "0" : `−${Math.abs(t)}`}°</span>
              ))}
            </div>
          </div>
          <p class="sr-only">Lead crystal operates from −40°C to +65°C, AGM from −20°C to +50°C, and lithium (LiFePO₄) charges from 0°C to +45°C.</p>
        </article>

        <article class="tile tile--deep" data-rv>
          <p class="label">Deep discharge</p>
          <p class="mid-fig">0V</p>
          <p class="muted">Recovers from a full discharge. Shelf life of 2+ years without recharging.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ BUILT FOR THE GULF (interactive) ============ -->
  <section class="heat" data-heat data-accent="heat">
    <div class="heat-media" aria-hidden="true">
      <video class="bgv" muted loop playsinline preload="none" poster="/media/gulf-1920.webp" data-bgvideo>
        <source src="/media/gulf-1280.mp4" type="video/mp4" media="(max-width: 900px)" />
        <source src="/media/gulf-1920.mp4" type="video/mp4" />
      </video>
      <div class="heat-shade"></div>
    </div>
    <div class="wrap heat-inner">
      <div class="heat-copy" data-rv>
        <p class="label eyebrow">Built for the Gulf</p>
        <h2 class="display h-lg">Rated to +65°C.</h2>
        <p class="lede">
          Summer in Saudi Arabia routinely passes 50°C, and equipment enclosures reach 60 to 65°C. Batteries designed for 25°C can fail in
          under a year. Lead crystal is rated for continuous operation up to 65°C.
        </p>
        <a class="link-arrow" href="/industrial-battery-selection-saudi-arabia/">Choosing industrial batteries for Saudi Arabia <span aria-hidden="true">→</span></a>
      </div>

      <div class="sim" data-sim data-rv>
        <div class="sim-head">
          <label class="label" for="sim-temp">Drag to set the enclosure temperature</label>
          <output class="sim-out" for="sim-temp" data-sim-out>55°C</output>
        </div>
        <input class="sim-range" id="sim-temp" type="range" min={T_MIN} max={T_MAX} step="1" value="55" data-sim-input />
        <div class="sim-scale mono" aria-hidden="true"><span>−40°C</span><span>+25°C</span><span>+70°C</span></div>
        <ul class="sim-list" aria-live="polite">
          {
            CHEMS.map((c) => (
              <li class="chem" data-chem data-min={c.min} data-max={c.max}>
                <div class="chem-top">
                  <span class="chem-name">{c.name}</span>
                  <span class="pill" data-pill>
                    {55 >= c.min && 55 <= c.max ? "In range" : "Out of range"}
                  </span>
                </div>
                <div class="chem-track" aria-hidden="true">
                  <span class="chem-bar" style={`left:${pct(c.min)}%;width:${pct(c.max) - pct(c.min)}%`} />
                  <span class="chem-mark" data-mark style={`left:${pct(55)}%`} />
                </div>
                <span class="chem-note mono">{c.note}</span>
              </li>
            ))
          }
        </ul>
        <p class="sim-foot">
          Ranges as published in <a href="/what-is-lead-crystal-battery-technology/">What is lead crystal battery technology?</a> The lithium
          figure is its charging range.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ THE RANGE (horizontal conveyor) ============ -->
  <section class="range" id="range" data-range data-accent="violet">
    <div class="range-pin" data-range-pin>
      <div class="wrap range-head">
        <div>
          <p class="label eyebrow">The range</p>
          <h2 class="display h-lg">{products.length} batteries. <span class="muted">2V to 12V.</span></h2>
        </div>
        <p class="lede">From {formatAh(minAh)} to {maxAh.toLocaleString("en-US")}Ah, in four voltage classes and four families.</p>
      </div>

      <div class="rail" data-rail tabindex="0" role="region" aria-label="Battery voltage classes">
        <div class="rail-track" data-rail-track>
          {
            VOLTS.map((x) => (
              <a class="vcard" href={`/product-category/${x.v}v/`} data-tilt>
                <span class="vglow" aria-hidden="true" />
                <img src={x.img} alt={`Leadcrystal ${x.v}V battery`} width="900" height="900" decoding="async" />
                <span class="vnum display">{x.v}V</span>
                <span class="vmeta mono">
                  {x.count} model{x.count === 1 ? "" : "s"} · {formatAh(x.lo)} to {x.hi.toLocaleString("en-US")}Ah
                </span>
                <span class="vuses">{x.uses}</span>
                <span class="vgo">
                  View {x.v}V range <span aria-hidden="true">→</span>
                </span>
              </a>
            ))
          }
          <a class="vcard vcard--all" href="/catalogue/">
            <span class="vnum display">All {products.length}</span>
            <span class="vuses">Filter by voltage, capacity, family and application. Every model has a downloadable spec sheet.</span>
            <span class="vgo">
              Open the catalogue <span aria-hidden="true">→</span>
            </span>
          </a>
        </div>
      </div>

      <div class="wrap fams">
        <span class="label">Browse by family</span>
        {
          FAMILIES.map((f) => (
            <a class="chip" href={`/catalogue/?type=${encodeURIComponent(f.key)}`}>
              {f.label} <span class="count">{familyCount(f.key)}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CORE INDUSTRIES (Anduril-style tabbed video) ============ -->
  <Industries />

  <!-- ============ INSIGHTS ============ -->
  <section class="section section--rule" data-accent="violet">
    <div class="wrap">
      <div class="row-head" data-rv>
        <div>
          <p class="label eyebrow">Insights</p>
          <h2 class="display h-md">From the research desk.</h2>
        </div>
        <a class="link-arrow" href="/insights/">All insights <span aria-hidden="true">→</span></a>
      </div>
      <div class="art-grid">
        {latest.map((a) => <div data-rv><ArticleCard article={a} /></div>)}
      </div>
    </div>
  </section>

  <!-- ============ DOWNLOADS ============ -->
  <section class="section section--tight section--rule">
    <div class="wrap downloads">
      <div class="dl" data-rv>
        <p class="label">PDF · {fileSize("downloads/Leadcrystal-company-profile.pdf")}</p>
        <h3 class="h-sm">Company profile</h3>
        <p class="muted">The Leadcrystal range, technology and company overview in one document.</p>
        <a class="btn btn--ghost btn--sm" href="/downloads/Leadcrystal-company-profile.pdf" target="_blank" rel="noopener">Download</a>
      </div>
      <div class="dl dl--accent" data-rv>
        <p class="label">Whitepaper · 14 pages</p>
        <h3 class="h-sm">60% lower TCO than VRLA</h3>
        <p class="muted">The total cost of ownership case for industrial backup, over a 15-year asset life.</p>
        <button class="btn btn--sm" type="button" data-open-whitepaper>Get the whitepaper</button>
      </div>
      <div class="dl" data-rv>
        <p class="label">PDF · per model</p>
        <h3 class="h-sm">Specification sheets</h3>
        <p class="muted">Full electrical and mechanical data for every battery, on each product page.</p>
        <a class="btn btn--ghost btn--sm" href="/catalogue/?view=table">Open the spec table</a>
      </div>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="final" data-accent="crystal">
    <div class="final-media" aria-hidden="true">
      <video class="bgv" muted loop playsinline preload="none" poster="/media/crystal-1280.webp" data-bgvideo>
        <source src="/media/crystal-1280.mp4" type="video/mp4" />
      </video>
      <div class="final-shade"></div>
    </div>
    <div class="wrap final-inner" data-rv>
      <p class="label eyebrow">Work with us</p>
      <h2 class="display h-xl">Let's shape the future, together.</h2>
      <p class="lede">Tell us about your site, load and backup time. Our engineers will size the right system.</p>
      <div class="cta-row">
        <a class="btn btn--light" href="/contact/">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/catalogue/">Browse the catalogue</a>
      </div>
    </div>
  </section>

  <WhitepaperDialog />
</Base>

<script>
  import "../scripts/home";
</script>

<style>
  /* ---------- Scroll progress ---------- */
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--acc));
    transform-origin: 0 50%;
    transform: scaleX(var(--scroll, 0));
  }

  /* ---------- Shared video backdrop ---------- */
  .bgv {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: calc(var(--header-h) + clamp(40px, 9vh, 120px));
    padding-bottom: clamp(24px, 4vh, 48px);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #050507;
    transform-origin: 70% 50%;
  }
  .hero-media .bgv {
    object-position: 72% 50%;
    inset: -14px;
    width: calc(100% + 28px);
    height: calc(100% + 28px);
    /* cursor parallax (sideways drift only, never a zoom) */
    translate: var(--px, 0px) var(--py, 0px);
  }
  /* a soft beam of light crossing the shot every few seconds */
  .hero-sweep {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mix-blend-mode: screen;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(150, 125, 255, 0.0) 40%,
      rgba(170, 150, 255, 0.16) 47%,
      rgba(220, 225, 255, 0.22) 50%,
      rgba(170, 150, 255, 0.16) 53%,
      rgba(150, 125, 255, 0) 60%,
      transparent 65%
    );
    background-size: 260% 100%;
    background-position: 130% 0;
    opacity: 0;
  }
  .hero-dust {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  @media (min-width: 900px) {
    /* keep the battery clear of the headline: slide the shot right and fade its left edge.
       `translate` is separate from the transform GSAP scrubs, so the two compose. */
    .hero-media .bgv {
      object-position: 50% 50%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 22%);
    }
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 5, 7, 0.9) 0%, rgba(5, 5, 7, 0.78) 32%, rgba(5, 5, 7, 0.18) 58%, rgba(5, 5, 7, 0) 80%),
      linear-gradient(0deg, var(--bg) 0%, rgba(8, 8, 10, 0) 32%);
  }
  .hero-inner {
    align-self: center;
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .hero-title {
    font-size: clamp(3.4rem, 9vw, 8.6rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  .hero-title .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero-title .line > span {
    display: inline-block;
  }
  .hero-title .line:last-child > span {
    background: linear-gradient(
      100deg,
      #fff 0%,
      var(--crystal) 22%,
      var(--accent-hi) 40%,
      #fff 48%,
      var(--accent-hi) 56%,
      var(--crystal) 76%,
      #fff 100%
    );
    background-size: 220% 100%;
    background-position: 0% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero .lede {
    color: #c9cad2;
    max-width: 46ch;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .hero-foot {
    position: relative;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 0;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--line);
  }
  @media (min-width: 900px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    padding: 18px 20px;
    background: rgba(8, 8, 10, 0.72);
    display: grid;
    gap: 6px;
  }
  @supports (backdrop-filter: blur(1px)) {
    .stat {
      background: rgba(10, 10, 14, 0.5);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
  }
  .stat dd {
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .stat .fig {
    font-size: clamp(1.7rem, 2.8vw, 2.4rem);
    font-weight: 750;
    font-stretch: 115%;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat .fig::before {
    content: attr(data-pre);
  }
  .stat .fig::after {
    content: attr(data-suf);
  }
  .stat .note {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 14px;
    width: 26px;
    height: 40px;
    margin-left: -13px;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    display: none;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 2px;
    height: 8px;
    margin-left: -1px;
    border-radius: 2px;
    background: #fff;
    animation: cue 1.8s var(--ease) infinite;
  }
  @keyframes cue {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    100% {
      transform: translateY(14px);
      opacity: 0;
    }
  }
  @media (min-height: 760px) and (min-width: 900px) {
    .scroll-cue {
      display: block;
    }
    .hero-foot {
      margin-bottom: 44px;
    }
  }

  /* load-in (one-shot, CSS only so it also runs without JS) */
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: rise 1.1s var(--ease) both;
      animation-delay: calc(0.25s + var(--i) * 0.12s);
    }
    .hero-title .line > span {
      animation: lineup 1.2s var(--ease) both;
      animation-delay: calc(0.15s + var(--i) * 0.12s);
    }
    .hero-title .line:last-child > span {
      animation:
        lineup 1.2s var(--ease) both calc(0.15s + var(--i) * 0.12s),
        shimmer 7s linear 1.6s infinite;
    }
    .hero-sweep {
      animation: sweep 8s ease-in-out 2.2s infinite;
    }
    .hero-media {
      animation: settle 2.2s var(--ease) both;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }
  @keyframes shimmer {
    from {
      background-position: 0% 0;
    }
    to {
      background-position: -220% 0;
    }
  }
  @keyframes sweep {
    0% {
      opacity: 0;
      background-position: 130% 0;
    }
    12% {
      opacity: 1;
    }
    55% {
      opacity: 1;
    }
    70%,
    100% {
      opacity: 0;
      background-position: -30% 0;
    }
  }
  @keyframes lineup {
    from {
      transform: translateY(105%);
    }
  }
  /* fade only: the shot holds one zoom (Keegan, 17 Nov) */
  @keyframes settle {
    from {
      opacity: 0;
    }
  }

  @media (max-width: 899px) {
    /* phones: the battery gets its own panel at the top that fades out under the headline */
    .hero {
      padding-top: calc(var(--header-h) + clamp(170px, 34svh, 300px));
    }
    .hero-inner {
      align-self: start;
    }
    .hero-media {
      bottom: auto;
      height: 62svh;
      -webkit-mask-image: linear-gradient(180deg, #000 42%, transparent 96%);
      mask-image: linear-gradient(180deg, #000 42%, transparent 96%);
    }
    .hero-shade {
      background: linear-gradient(180deg, rgba(5, 5, 7, 0.4) 0%, rgba(5, 5, 7, 0) 22%, rgba(5, 5, 7, 0.2) 55%, rgba(5, 5, 7, 0.7) 100%);
    }
    .hero-media .bgv {
      object-position: 79% 50%;
    }
    .stat {
      padding: 14px 16px;
    }
  }

  /* ---------- Manifesto ---------- */
  .manifesto {
    padding-block: clamp(96px, 16vw, 220px);
  }
  .manifesto .wrap {
    display: grid;
    gap: 28px;
  }
  .manifesto-text {
    margin: 0;
    font-size: clamp(1.9rem, 4.6vw, 4.1rem);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }
  .manifesto-text .w {
    transition: color 0.3s;
  }

  /* ---------- How it works ---------- */
  .science {
    position: relative;
  }
  .science-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(60% 55% at 70% 50%, rgba(91, 59, 255, 0.16), transparent 70%),
      radial-gradient(40% 40% at 20% 80%, rgba(190, 201, 255, 0.06), transparent 70%);
  }
  .science-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  @media (min-width: 900px) {
    /* keep the copy column calm: particles dim as they drift behind it */
    .science-stage::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(8, 8, 10, 0.88) 0%, rgba(8, 8, 10, 0.55) 30%, rgba(8, 8, 10, 0) 50%);
      pointer-events: none;
    }
  }
  .science-fallback {
    position: absolute;
    inset: 0;
    background: url(/media/crystal-1280.webp) 70% 50% / cover no-repeat;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .science-fallback::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 8, 10, 0.95) 20%, rgba(8, 8, 10, 0.5));
  }
  :global(.no-3d) .science-fallback {
    opacity: 1;
  }
  :global(.no-3d) .science-canvas,
  :global(.no-3d) .science-hud {
    display: none;
  }
  .science-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(20px, 5vh, 48px);
    display: flex;
    align-items: center;
    gap: 24px;
    pointer-events: none;
  }
  .hud-num {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .hud-num span {
    color: #fff;
  }
  .hud-steps {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .hud-steps li {
    transition: color 0.4s;
  }
  .hud-steps li.is-on {
    color: var(--acc);
  }
  .hud-bar {
    flex: 1;
    height: 1px;
    background: var(--line-2);
    max-width: 260px;
  }
  .hud-bar span {
    display: block;
    height: 100%;
    background: var(--acc);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }
  .science-steps {
    position: relative;
    margin-top: -100svh;
  }
  .step {
    min-height: 100svh;
    display: flex;
    align-items: center;
  }
  .step .wrap {
    width: 100%;
  }
  .step-card {
    max-width: 480px;
    display: grid;
    gap: 20px;
  }
  .step-card h3 {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
  }
  .step-body {
    margin: 0;
    font-size: clamp(1.02rem, 1.3vw, 1.15rem);
    color: #c9cad2;
  }
  .facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .facts li {
    font: 500 0.74rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 9px 12px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    color: var(--text);
    background: rgba(8, 8, 10, 0.55);
  }
  @media (max-width: 899px) {
    .science-hud {
      top: calc(var(--header-h) + 12px);
      bottom: auto;
    }
    .hud-steps,
    .hud-bar {
      display: none;
    }
    .step {
      align-items: flex-end;
      padding-bottom: 7vh;
    }
    .step-card {
      max-width: none;
      padding: 22px;
      border-radius: var(--radius-lg);
      border: 1px solid var(--line-2);
      background: rgba(8, 8, 10, 0.86);
    }
  }

  /* ---------- Crystal band ---------- */
  .band {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }
  .band-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #060608 url(/media/crystal-1920.webp) center / cover;
    will-change: clip-path;
  }
  .band-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 5, 7, 0.9) 0%, rgba(5, 5, 7, 0.55) 45%, rgba(5, 5, 7, 0.1) 100%),
      linear-gradient(0deg, rgba(5, 5, 7, 0.6), transparent 40%);
  }
  .band-inner {
    display: grid;
    gap: 22px;
    justify-items: start;
    padding-block: 120px;
  }
  .band-inner .lede {
    color: #d3d4db;
  }

  /* ---------- Performance bento ---------- */
  .bento {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .tile--cycles,
    .tile--temp {
      grid-column: span 2;
    }
  }
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }
    .tile--cycles {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
    .tile--temp {
      grid-column: 1 / 3;
    }
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(22px, 2.6vw, 34px);
    border: 1px solid var(--line);
    border-radius: 18px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(91, 59, 255, 0.1), transparent 60%),
      var(--panel);
    transition: border-color 0.4s var(--ease);
  }
  .tile:hover {
    border-color: rgba(140, 117, 255, 0.35);
  }
  .tile p {
    margin: 0;
  }
  .big-fig {
    font-size: clamp(4rem, 10vw, 8.5rem);
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.05em;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(180deg, #fff 30%, var(--crystal));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mid-fig {
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 750;
    font-stretch: 118%;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .mid-fig small {
    font-size: 0.5em;
    margin-left: 2px;
    color: var(--muted);
  }
  .mid-fig .to {
    font-size: 0.45em;
    color: var(--muted);
    font-weight: 500;
    vertical-align: middle;
    margin-inline: 4px;
  }
  .tile--cycles {
    min-height: 420px;
    align-content: end;
  }
  .tile--cycles .muted {
    max-width: 40ch;
  }
  .cycle-ring {
    position: absolute;
    top: clamp(16px, 3vw, 36px);
    right: clamp(16px, 3vw, 36px);
    width: clamp(150px, 22vw, 260px);
    opacity: 0.9;
  }
  .cycle-ring line {
    stroke: var(--accent-hi);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .charge {
    position: relative;
    width: 140px;
    height: 140px;
    display: grid;
    place-items: center;
  }
  .charge svg {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
  }
  .charge circle {
    fill: none;
    stroke-width: 6;
  }
  .charge .track {
    stroke: var(--line-2);
  }
  .charge .fill {
    stroke: var(--crystal);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .charge .mid-fig {
    font-size: 2.3rem;
  }
  .tile--recycle {
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(127, 224, 176, 0.12), transparent 60%),
      var(--panel);
  }
  .tile--recycle .mid-fig {
    color: var(--ok);
  }
  .temp-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 12px 32px;
  }
  .temp-head .muted {
    max-width: 30ch;
  }
  .ranges {
    display: grid;
    gap: 12px;
    margin-top: 14px;
    padding-bottom: 26px;
    position: relative;
  }
  .rg {
    display: grid;
    grid-template-columns: minmax(110px, 160px) 1fr;
    align-items: center;
    gap: 14px;
    font-size: 0.88rem;
    color: var(--muted);
  }
  .rg-track {
    position: relative;
    height: 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
  }
  .rg-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 6px;
    background: #4a4b55;
    transform-origin: 0 50%;
  }
  .rg--lc .rg-name {
    color: #fff;
    font-weight: 600;
  }
  .rg--lc .rg-bar {
    background: linear-gradient(90deg, #6aa6ff, var(--accent-hi) 55%, #ff8a3d);
    box-shadow: 0 0 18px rgba(140, 117, 255, 0.45);
  }
  .rg-axis {
    position: absolute;
    left: calc(min(160px, 110px + 3vw) + 14px);
    right: 0;
    bottom: 0;
    height: 16px;
    font-size: 0.7rem;
    color: var(--dim);
  }
  .rg-axis span {
    position: absolute;
    transform: translateX(-50%);
  }
  @media (max-width: 520px) {
    .rg {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .rg-axis {
      left: 0;
    }
  }

  /* ---------- Heat / simulator ---------- */
  .heat {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-block: clamp(96px, 12vw, 160px);
  }
  .heat-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #120a06 url(/media/gulf-1920.webp) center / cover;
  }
  .heat-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 6, 6, 0.9) 0%, rgba(8, 6, 6, 0.6) 50%, rgba(8, 6, 6, 0.45) 100%),
      linear-gradient(0deg, var(--bg) 0%, transparent 25%),
      linear-gradient(180deg, var(--bg) 0%, transparent 20%);
  }
  .heat-inner {
    display: grid;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  @media (min-width: 1000px) {
    .heat-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  .heat-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .heat-copy .lede {
    color: #dcd6d0;
  }
  .sim {
    padding: clamp(22px, 3vw, 34px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(12, 10, 12, 0.86);
    display: grid;
    gap: 16px;
  }
  @supports (backdrop-filter: blur(1px)) {
    .sim {
      background: rgba(14, 12, 14, 0.62);
      backdrop-filter: blur(20px) saturate(1.2);
      -webkit-backdrop-filter: blur(20px) saturate(1.2);
    }
  }
  .sim-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
  }
  .sim-out {
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    font-weight: 800;
    font-stretch: 120%;
    letter-spacing: -0.04em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--heat-col, #fff);
    transition: color 0.3s;
  }
  .sim-range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 44px;
    background: transparent;
    cursor: grab;
    margin: 0;
  }
  .sim-range:active {
    cursor: grabbing;
  }
  .sim-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, #5ab0ff 0%, #8c75ff 45%, #ff8a3d 85%, #ff4d4d 100%);
  }
  .sim-range::-moz-range-track {
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, #5ab0ff 0%, #8c75ff 45%, #ff8a3d 85%, #ff4d4d 100%);
  }
  .sim-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 26px;
    height: 26px;
    margin-top: -10px;
    border-radius: 50%;
    background: #fff;
    border: 0;
    box-shadow:
      0 0 0 6px rgba(255, 255, 255, 0.14),
      0 4px 18px rgba(0, 0, 0, 0.5);
  }
  .sim-range::-moz-range-thumb {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #fff;
    border: 0;
    box-shadow:
      0 0 0 6px rgba(255, 255, 255, 0.14),
      0 4px 18px rgba(0, 0, 0, 0.5);
  }
  .sim-range:focus-visible {
    outline: 2px solid var(--accent-hi);
    outline-offset: 4px;
    border-radius: 8px;
  }
  .sim-scale {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    color: var(--muted);
    margin-top: -8px;
  }
  .sim-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .chem {
    display: grid;
    gap: 8px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.02);
    transition:
      border-color 0.3s,
      background 0.3s,
      opacity 0.3s;
  }
  .chem-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .chem-name {
    font-weight: 600;
  }
  .pill {
    font: 600 0.7rem/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 7px 10px;
    border-radius: 999px;
    background: rgba(127, 224, 176, 0.14);
    color: var(--ok);
    white-space: nowrap;
  }
  .chem.is-out {
    opacity: 0.72;
  }
  .chem.is-out .pill {
    background: rgba(255, 110, 110, 0.14);
    color: #ff9b9b;
  }
  .chem-track {
    position: relative;
    height: 8px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.05);
  }
  .chem-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.22);
  }
  .chem:first-child .chem-bar {
    background: linear-gradient(90deg, #6aa6ff, var(--accent-hi) 55%, #ff8a3d);
  }
  .chem-mark {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 2px;
    margin-left: -1px;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 0 10px #fff;
  }
  .chem-note {
    font-size: 0.74rem;
