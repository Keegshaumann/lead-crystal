---
// Articles keep their old WordPress URLs at the site root, e.g. /lead-crystal-tco-whitepaper/
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import WhitepaperDialog from "../components/WhitepaperDialog.astro";
import { articles, formatDate, type Article } from "../lib/catalogue";
import { SITE } from "../site";

export function getStaticPaths() {
  return articles.map((a) => ({ params: { article: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Article };

const WP_PANEL = `<aside class="wp-panel"><p><strong>Full research:</strong> this article summarises the key findings. Download the complete 14-page whitepaper with all data, charts and 46+ verified sources.</p><button class="btn btn--sm" type="button" data-open-whitepaper>Download the whitepaper →</button></aside>`;
const body = a.html
  .replace(/<!--WHITEPAPER-->/g, WP_PANEL)
  .replace(/<table>/g, '<div class="table-scroll"><table>')
  .replace(/<\/table>/g, "</table></div>");
const hasWhitepaper = a.html.includes("<!--WHITEPAPER-->");
const more = articles.filter((x) => x.slug !== a.slug).slice(0, 3);
const url = `${SITE.url}/${a.slug}/`;
---

<Base
  title={a.seoTitle || a.title}
  description={a.seoDescription || a.excerpt}
  type="article"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: a.title,
      description: a.seoDescription || a.excerpt,
      datePublished: a.date,
      dateModified: a.modified,
      mainEntityOfPage: url,
      author: { "@type": "Organization", name: "Leadcrystal", url: SITE.url },
      publisher: { "@id": `${SITE.url}/#organization` },
      image: `${SITE.url}/images/og-default.jpg`,
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
        { "@type": "ListItem", position: 2, name: "Insights", item: `${SITE.url}/insights/` },
        { "@type": "ListItem", position: 3, name: a.title },
      ],
    },
  ]}
>
  <article>
    <header class="ahead">
      <div class="grid-bg g" aria-hidden="true"></div>
      <div class="wrap narrow">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs mono">
            <li><a href="/">Home</a></li>
            <li><a href="/insights/">Insights</a></li>
          </ol>
        </nav>
        <p class="label label--accent">{a.categories.join(" · ")}</p>
        <h1 class="display h-md">{a.title}</h1>
        <p class="meta mono dim">
          <time datetime={a.date}>{formatDate(a.date)}</time>
          <span>·</span>
          <span>{a.readingMinutes} min read</span>
          <span>·</span>
          <span>Leadcrystal</span>
        </p>
      </div>
    </header>

    <div class="wrap narrow body">
      <div class="prose" set:html={body} />

      <aside class="end-cta">
        <p class="label">Clean. Efficient. Recyclable.</p>
        <p class="h-sm">Find the right lead crystal battery for your project.</p>
        <div class="row">
          <a class="btn" href="/catalogue/">Browse the catalogue <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/contact/">Ask an engineer</a>
        </div>
      </aside>
    </div>
  </article>

  <section class="section section--tight section--rule">
    <div class="wrap">
      <h2 class="display h-md more-h">More insights</h2>
      <div class="more">{more.map((m) => <ArticleCard article={m} />)}</div>
    </div>
  </section>

  {hasWhitepaper && <WhitepaperDialog />}
</Base>

<style>
  .narrow {
    max-width: calc(760px + var(--gutter) * 2);
  }
  .ahead {
    position: relative;
    padding-block: clamp(40px, 7vw, 88px) clamp(28px, 4vw, 48px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .ahead .g {
    position: absolute;
    inset: 0;
    opacity: 0.5;
  }
  .ahead .wrap {
    position: relative;
    display: grid;
    gap: 18px;
  }
  .ahead h1 {
    font-stretch: 110%;
    line-height: 1.05;
  }
  .ahead p {
    margin: 0;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.74rem;
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 8px;
    color: var(--line-2);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.78rem;
  }
  .body {
    padding-block: clamp(36px, 6vw, 72px);
  }
  .body :global(.wp-panel) {
    display: grid;
    gap: 14px;
    justify-items: start;
    margin-block: 2em;
    padding: 22px 24px;
    border: 1px solid rgba(140, 117, 255, 0.45);
    border-left: 3px solid var(--accent-hi);
    border-radius: 8px;
    background: rgba(91, 59, 255, 0.08);
  }
  .body :global(.wp-panel p) {
    margin: 0;
    font-size: 0.98rem;
  }
  .end-cta {
    display: grid;
    gap: 14px;
    margin-top: 64px;
    padding: 32px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--panel);
  }
  .end-cta p {
    margin: 0;
  }
  .end-cta .row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .more-h {
    margin-bottom: 32px;
  }
  .more {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
</style>
