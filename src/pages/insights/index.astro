---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { articles } from "../../lib/catalogue";
const [lead, ...rest] = articles;
---

<Base
  title="Insights: Lead Crystal Battery Research and Guides"
  description="Guides, comparisons and research on lead crystal batteries: technology, total cost of ownership, ESG, maintenance and industrial selection in Saudi Arabia."
>
  <PageHead crumbs={[{ label: "Insights" }]} title="Insights" eyebrow="Research · guides · comparisons" />
  <section class="section section--tight">
    <div class="wrap">
      <a class="lead reveal" href={`/${lead.slug}/`}>
        <p class="label label--accent">Latest · {lead.categories.join(" · ")}</p>
        <h2 class="display h-md">{lead.title}</h2>
        <p class="lede">{lead.excerpt}</p>
        <span class="link-arrow">Read the article <span aria-hidden="true">→</span></span>
      </a>
      <div class="grid">
        {rest.map((a, i) => <div class="reveal" style={`--d:${(i % 3) * 0.07}s`}><ArticleCard article={a} /></div>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .lead {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: clamp(28px, 5vw, 56px);
    margin-bottom: 16px;
    border: 1px solid rgba(140, 117, 255, 0.4);
    border-radius: 14px;
    background:
      radial-gradient(80% 120% at 100% 0%, rgba(91, 59, 255, 0.22), transparent 60%),
      var(--panel);
    text-decoration: none;
    transition: border-color 0.3s;
  }
  .lead:hover {
    border-color: var(--accent-hi);
  }
  .lead p {
    margin: 0;
  }
  .lead h2 {
    max-width: 24ch;
    font-stretch: 112%;
  }
  .grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
</style>
