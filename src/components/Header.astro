---
import Logo from "./Logo.astro";
import { NAV } from "../site";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href !== "/#technology" && (path === href || (href !== "/" && path.startsWith(href)) || (href === "/catalogue/" && path.startsWith("/product")));
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Leadcrystal home"><Logo height={28} /></a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          NAV.map((n) => (
            <li>
              <a href={n.href} aria-current={isActive(n.href) ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn--sm btn--light cta" href="/contact/">Contact</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-btn>
        <span class="sr-only">Menu</span>
        <span class="bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile" id="mobile-menu" hidden data-menu>
    <nav class="wrap" aria-label="Mobile">
      <a href="/">Home</a>
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/contact/">Contact</a>
      <p class="label">Riyadh, Saudi Arabia</p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    transition:
      background 0.35s var(--ease),
      border-color 0.35s var(--ease),
      backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgba(8, 8, 10, 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: var(--line);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    flex-shrink: 0;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    padding: 10px 14px;
    font-size: 0.94rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    color: #fff;
  }
  .nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 1px;
    background: var(--accent-hi);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }
  .bars {
    display: grid;
    gap: 6px;
    width: 18px;
    margin: auto;
  }
  .bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .is-open .bars i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .is-open .bars i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }
  .mobile {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: rgba(8, 8, 10, 0.97);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    overflow-y: auto;
  }
  .mobile nav {
    display: grid;
    padding-block: 24px 48px;
  }
  .mobile a {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.6rem;
    font-weight: 700;
    font-stretch: 115%;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mobile .label {
    margin-top: 28px;
  }
  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 420px) {
    .cta {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const btn = header.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const menu = header.querySelector<HTMLElement>("[data-menu]")!;
  const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 12);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
  const setOpen = (open: boolean) => {
    btn.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
    header.classList.toggle("is-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  };
  btn.addEventListener("click", () => setOpen(menu.hidden));
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu.hidden) {
      setOpen(false);
      btn.focus();
    }
  });
</script>
