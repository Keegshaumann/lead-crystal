---
// Inner-page header band with breadcrumb, title and optional intro.
interface Props {
  crumbs: { href?: string; label: string }[];
  title: string;
  eyebrow?: string;
}
const { crumbs, title, eyebrow } = Astro.props;
---

<section class="ph">
  <div class="grid-bg ph-grid" aria-hidden="true"></div>
  <div class="wrap">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs mono">
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    {eyebrow && <p class="label eyebrow label--accent">{eyebrow}</p>}
    <h1 class="display h-lg">{title}</h1>
    <slot />
  </div>
</section>

<style>
  .ph {
    position: relative;
    padding-block: clamp(40px, 7vw, 88px) clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .ph-grid {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    pointer-events: none;
  }
  .ph .wrap {
    position: relative;
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .ph h1 {
    max-width: 18ch;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    font-size: 0.74rem;
    color: var(--dim);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 8px;
    color: var(--line-2);
  }
  .crumbs a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
</style>
