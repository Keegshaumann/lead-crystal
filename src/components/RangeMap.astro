---
// Every battery in the range plotted by voltage (rows) and capacity (log scale).
// Each dot links to its product page.
import { products, VOLTAGES, FAMILIES, familyOf, formatAh } from "../lib/catalogue";

const MIN = 4;
const MAX = 3000;
const pos = (ah: number) => ((Math.log(ah) - Math.log(MIN)) / (Math.log(MAX) - Math.log(MIN))) * 100;
const TICKS = [5, 10, 20, 50, 100, 200, 500, 1000, 2000];
const COLORS: Record<string, string> = {
  Standard: "#eeeef1",
  "Front Terminal": "#8c75ff",
  EV: "#62d2ff",
  "High-Cycle": "#7fe0b0",
};

const rows = [...VOLTAGES].reverse().map((v) => {
  const list = products.filter((p) => p.voltage === v);
  const lanes = FAMILIES.filter((f) => list.some((p) => p.family === f.key)).map((f) => f.key);
  return { v, list, lanes };
});
---

<figure class="rangemap" aria-labelledby="rangemap-cap">
  <div class="scroll">
    <div class="plot">
      {
        rows.map((r) => (
          <div class="row" style={`--lanes:${r.lanes.length}`}>
            <a class="rlabel" href={`/product-category/${r.v}v/`}>
              <span class="v">{r.v}V</span>
              <span class="n mono">{r.list.length} models</span>
            </a>
            <div class="track">
              {r.list.map((p) => (
                <a
                  class="dot"
                  href={`/product/${p.slug}/`}
                  style={`left:${pos(p.capacityAh).toFixed(2)}%;--lane:${r.lanes.indexOf(p.family)};--c:${COLORS[p.family]}`}
                  aria-label={`${p.sku}: ${p.voltage}V ${formatAh(p.capacityAh)} ${familyOf(p).label}`}
                >
                  <span class="tip mono" aria-hidden="true">
                    {p.sku}
                    <b>{formatAh(p.capacityAh)}</b>
                  </span>
                </a>
              ))}
            </div>
          </div>
        ))
      }
      <div class="axis" aria-hidden="true">
        <span class="rlabel"></span>
        <div class="track">
          {
            TICKS.map((t) => (
              <span class="tick mono" style={`left:${pos(t).toFixed(2)}%`}>
                {t >= 1000 ? `${t / 1000}k` : t}
              </span>
            ))
          }
          <span class="unit mono">Ah</span>
        </div>
      </div>
    </div>
  </div>
  <figcaption id="rangemap-cap">
    <ul class="legend">
      {
        FAMILIES.map((f) => (
          <li>
            <i style={`--c:${COLORS[f.key]}`} />
            {f.label}
          </li>
        ))
      }
    </ul>
    <span class="dim">Capacity on a log scale. Select a dot to open the model.</span>
  </figcaption>
</figure>

<style>
  .rangemap {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: linear-gradient(180deg, var(--panel), var(--bg-2));
    padding: clamp(18px, 3vw, 32px);
  }
  .scroll {
    overflow-x: auto;
    padding-top: 34px;
    margin-top: -34px;
  }
  .plot {
    min-width: 680px;
    display: grid;
  }
  .row,
  .axis {
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
  }
  .row {
    border-bottom: 1px solid var(--line);
    min-height: calc(var(--lanes) * 16px + 34px);
  }
  .row:first-child {
    border-top: 1px solid var(--line);
  }
  .rlabel {
    display: grid;
    gap: 2px;
    text-decoration: none;
  }
  .rlabel .v {
    font-size: 1.35rem;
    font-weight: 800;
    font-stretch: 125%;
    letter-spacing: -0.02em;
  }
  .rlabel .n {
    font-size: 0.68rem;
    color: var(--dim);
    letter-spacing: 0.08em;
  }
  a.rlabel:hover .v {
    color: var(--crystal);
  }
  .track {
    position: relative;
    height: calc(var(--lanes, 1) * 16px + 34px);
    margin-right: 18px;
    background-image: repeating-linear-gradient(90deg, transparent 0 calc(100% / 9 - 1px), rgba(255, 255, 255, 0.035) calc(100% / 9 - 1px) calc(100% / 9));
  }
  .dot {
    position: absolute;
    top: calc(17px + var(--lane) * 16px);
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--c);
    box-shadow:
      0 0 0 3px var(--panel),
      0 0 14px color-mix(in srgb, var(--c) 45%, transparent);
    transition: transform 0.25s var(--ease);
    z-index: 1;
  }
  .dot:hover,
  .dot:focus-visible {
    transform: scale(1.5);
    z-index: 3;
  }
  .tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%) scale(0.667);
    transform-origin: bottom center;
    white-space: nowrap;
    padding: 6px 9px;
    border-radius: 4px;
    background: #fff;
    color: #0a0a0c;
    font-size: 0.78rem;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
  }
  .tip b {
    margin-left: 6px;
    color: var(--accent);
  }
  .dot:hover .tip,
  .dot:focus-visible .tip {
    opacity: 1;
  }
  .axis .track {
    height: 30px;
    background: none;
    --lanes: 0;
  }
  .tick,
  .unit {
    position: absolute;
    top: 10px;
    transform: translateX(-50%);
    font-size: 0.68rem;
    color: var(--dim);
  }
  .unit {
    left: auto;
    right: -18px;
    transform: none;
    color: var(--muted);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 18px;
    font-size: 0.85rem;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c);
  }
</style>
